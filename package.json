{
  "name": "gitmoru",
  "version": "0.4.0",
  "license": "MIT",
  "type": "module",
  "description": "두더지 모루가 저장소를 파보고 무엇이 바뀌었는지 알려주는 개인용 도구",
  "main": "electron/main.mjs",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gitmoru": "bin/gitmoru.js"
  },
  "scripts": {
    "app": "node scripts/dev-app.mjs",
    "app:build": "pnpm build && electron .",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-mcp.mjs",
    "icon": "tsx scripts/make-icon.ts",
    "assets": "tsx scripts/make-assets.ts",
    "sprites": "tsx scripts/preview-sprites.ts",
    "avatar": "tsx scripts/make-org-avatar.ts",
    "serve": "node bin/gitmoru.js",
    "mcp": "tsx src/mcp/index.ts",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "style": "node scripts/check-style.mjs",
    "check": "pnpm typecheck && pnpm style && pnpm test && pnpm build",
    "build:mcp": "node scripts/build-mcp.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^38.0.0",
    "esbuild": "^0.28.1",
    "motion": "^12.43.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitmoru/gitmoru.git"
  },
  "homepage": "https://gitmoru.dev",
  "bugs": {
    "url": "https://github.com/gitmoru/gitmoru/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "github",
    "incident-response",
    "force-push",
    "git",
    "security",
    "claude",
    "model-context-protocol"
  ],
  "files": [
    "bin",
    "dist",
    "dist-mcp",
    "server",
    "SAFETY.md"
  ]
}
